# /etc/dapps/dapps.env - deployment-level configuration for the DAPPS daemon.
#
# Seeded from /usr/share/dapps/dapps.env.example on first install and never overwritten
# by a package upgrade. Edit it and "systemctl restart dapps".
#
# WHAT BELONGS HERE, AND WHAT DOES NOT. Almost nothing does. Callsign, bearer, ports,
# forwarding, discovery and the rest are configured in the dashboard's /Setup and /Config
# pages and stored in the database - that is the operator surface, and it is live. The
# env vars below exist for the things the dashboard cannot own: how the process is
# launched, and decisions the package itself has made.
#
# DAPPS_* variables here SEED a setting that has no stored value yet, on first start
# only; afterwards the dashboard owns it and this file is ignored for that setting. (The
# other mode - every variable re-applied at every start and badged read-only in the
# dashboard - is DAPPS_ENV_MANAGED=true, which is what a pdn-supervised node sets. Do not
# set it here unless you are managing this node's config from outside it.)
#
# The full list of variables is at https://packet-net.github.io/dapps/configure/

# Where the dashboard, REST API and MCP endpoint listen. Read by ASP.NET at every start,
# so unlike the DAPPS_* variables this one always takes effect. 0.0.0.0 because a real
# deployment is administered from another machine; narrow it to 127.0.0.1 if you front it
# with a reverse proxy. Set the sysop password on the first visit before exposing it more
# widely. Binding below port 1024 needs
#   setcap 'cap_net_bind_service=+ep' /usr/lib/dapps/dapps.core
ASPNETCORE_URLS=http://0.0.0.0:5000

# apt owns upgrades on this node, so the hourly poll of GitHub Releases and the dashboard
# banner it feeds would only ever nag about a version "apt upgrade" is already bringing.
# This package ships no dapps-updater unit, so the banner's Apply button has nothing to
# trigger either. Set it to true if you would rather see the upstream release appear on
# the dashboard as soon as it is cut - the update still arrives via apt.
DAPPS_UPDATE_CHECK_ENABLED=false

# Pre-seed the callsign for an automated deployment, instead of typing it into /Setup.
# First start only - after that the dashboard owns it.
#DAPPS_CALLSIGN=M0LTE-1

# Which node this DAPPS talks to. Defaults suit BPQ on the same host; see
# https://packet-net.github.io/dapps/connect/ for XRouter over RHPv2 and MeshCore.
#DAPPS_NODE_BEARER=agw
#DAPPS_NODE_HOST=127.0.0.1
#DAPPS_AGW_PORT=8000

# The MQTT broker DAPPS serves to local applications. Move it off 1883 if a real broker
# already has that port on this host.
#DAPPS_MQTT_PORT=1883
