<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- zstd with a shared dictionary for DAPPSv1 session payloads
         (fmt=zN, see Compression/PayloadCompression.cs). -->
    <PackageReference Include="ZstdSharp.Port" />
  </ItemGroup>

  <ItemGroup>
    <!-- Byte-exact: every node must hold identical bytes for a version.
         .gitattributes marks *.dict binary so no checkout rewrites them. -->
    <EmbeddedResource Include="Compression\*.dict" LogicalName="dapps.client.Compression.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="dapps.core.tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- RHPv2 (Remote Host Protocol v2) client, used as DAPPS's bearer
         when the local packet node is XRouter. Multi-targets net8.0 +
         net10.0; this project pulls the net10.0 build. -->
    <PackageReference Include="RhpV2.Client" />
  </ItemGroup>

</Project>
