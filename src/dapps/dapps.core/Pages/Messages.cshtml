@page
@model MessagesModel
@{
    ViewData["Title"] = $"DAPPS - messages ({Model.Options.Callsign})";
    ViewData["Active"] = "messages";
    ViewData["PageTitle"] = "Messages";
    ViewData["PageSubtitle"] = "Outbound queue, local inbox, dropped, and live arrivals - all in one place.";
    var tab = Model.Tab;
}

@section Actions {
    <a class="btn sm" href="~/Compose">Compose</a>
}

@section Tabs {
    <a href="~/Messages?tab=outbound" class="@(tab == "outbound" ? "active" : "")">Outbound queue <span class="count" id="cnt-outbound">0</span></a>
    <a href="~/Messages?tab=inbox" class="@(tab == "inbox" ? "active" : "")">Local inbox <span class="count" id="cnt-inbox">0</span></a>
    <a href="~/Messages?tab=dropped" class="@(tab == "dropped" ? "active" : "")">Dropped <span class="count" id="cnt-dropped">0</span></a>
    <a href="~/Messages?tab=live" class="@(tab == "live" ? "active" : "")">Live arrivals <span id="sse-state" class="pill">connecting</span></a>
}

@if (tab == "outbound")
{
    <div class="panel">
        <h3>Outbound queue</h3>
        <p class="panel-sub">Messages for other nodes, waiting to go. Sent as soon as queued, or within 30 s. Click an id for the payload.</p>
        <table>
            <thead>
                <tr>
                    <th style="width: 8.5rem;">Id</th>
                    <th>Destination</th>
                    <th>From</th>
                    <th class="numeric">Bytes</th>
                    <th>Age</th>
                    <th>State</th>
                </tr>
            </thead>
            <tbody id="outbound-body"><tr><td colspan="6" class="muted" style="text-align:center;">loading</td></tr></tbody>
        </table>
    </div>
}
else if (tab == "inbox")
{
    <div class="panel">
        <h3>Local inbox</h3>
        <p class="panel-sub">Arrived for an app here, not yet acknowledged by it. A growing inbox means the app isn't acknowledging. Drop one you no longer want and the app never gets it.</p>
        @Html.AntiForgeryToken()
        <div class="err-banner" id="inbox-error" hidden></div>
        <table>
            <thead>
                <tr>
                    <th style="width: 8.5rem;">Id</th>
                    <th>Destination</th>
                    <th>From</th>
                    <th class="numeric">Bytes</th>
                    <th>Age</th>
                    <th>Expires</th>
                    <th>State</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="inbox-body"><tr><td colspan="8" class="muted" style="text-align:center;">loading</td></tr></tbody>
        </table>
    </div>
}
else if (tab == "dropped")
{
    <div class="panel">
        <h3>Recently dropped</h3>
        <p class="panel-sub">Messages DAPPS gave up on, with the reason.</p>
        <table>
            <thead>
                <tr>
                    <th style="width: 8.5rem;">Id</th>
                    <th>Destination</th>
                    <th>From</th>
                    <th>Reason</th>
                    <th>When</th>
                </tr>
            </thead>
            <tbody id="dropped-body"><tr><td colspan="5" class="muted" style="text-align:center;">loading</td></tr></tbody>
        </table>
    </div>
}
else
{
    <div class="panel">
        <h3>Live arrivals</h3>
        <p class="panel-sub">Every message as it arrives. Click a row for its payload.</p>
        <div class="row-form" style="margin-bottom: 1rem;">
            <div class="field">
                <label for="filter-app">App</label>
                <input id="filter-app" type="text" placeholder="e.g. mail" />
            </div>
            <div class="field">
                <label for="filter-callsign">Callsign (from or via)</label>
                <input id="filter-callsign" type="text" placeholder="e.g. M0LTE" />
            </div>
            <div class="field">
                <label for="filter-dest">Destination</label>
                <input id="filter-dest" type="text" placeholder="substring" />
            </div>
            <button class="btn ghost sm" type="button" id="filter-clear">Clear</button>
        </div>
        <span class="muted" id="filter-summary" style="font-size: 0.78rem;">showing all rows</span>
        <table id="inbound-table">
            <thead>
                <tr>
                    <th style="width: 11rem;">Received (UTC)</th>
                    <th style="width: 7rem;">Id</th>
                    <th style="width: 9rem;">From</th>
                    <th>Destination</th>
                    <th class="numeric" style="width: 6rem;">Bytes</th>
                    <th class="numeric" style="width: 5rem;">TTL</th>
                </tr>
            </thead>
            <tbody id="inbound-body">
                <tr><td colspan="6" class="muted" style="text-align:center;">waiting for events</td></tr>
            </tbody>
        </table>
        <p class="muted-inline" style="margin-top: 0.6rem;">
            Showing the last <span id="inbound-count">0</span> event(s) since this tab opened.
        </p>
    </div>
}
<style>
    tr.inbound-row { cursor: pointer; }
    tr.selected td { background: var(--accent-soft); }
    tr.payload-row td { background: var(--bg-2); }
    tr.payload-row pre {
        max-height: 24rem; overflow: auto; margin: 0; padding: 0.5rem;
        font-size: 0.78rem; white-space: pre-wrap; word-break: break-all;
        font-family: var(--font-mono);
    }
    .payload-meta { font-size: 0.78rem; color: var(--text-muted); margin-bottom: 0.4rem; }
    .payload-tabs button {
        font-size: 0.75rem; padding: 0.15rem 0.55rem; margin-right: 0.25rem;
        border-radius: 4px; cursor: pointer;
        background: var(--surface-2); color: var(--text); border: 1px solid var(--border);
    }
    .payload-tabs button.active { background: var(--accent); color: white; border-color: var(--accent); }
    code.msg-id-link {
        cursor: pointer; color: var(--accent); text-decoration: underline dotted;
        text-underline-offset: 2px;
    }
    code.msg-id-link:hover { color: var(--accent-hover); text-decoration: underline; }
</style>

<script>
(function () {
    const tab = '@tab';
    const escape = (s) => String(s ?? '').replace(/[&<>"']/g, c =>
        ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    // Who a message is from (the originator) and, when it came through
    // another station, the neighbour that handed it to us.
    const via = (m) => !!m.viaCallsign && m.viaCallsign.toUpperCase() !== String(m.sourceCallsign ?? '').toUpperCase();
    const fromCell = (m) => `<code>${escape(m.sourceCallsign)}</code>`
        + (via(m) ? ` <span class="muted">via <code>${escape(m.viaCallsign)}</code></span>` : '');
    const fmtAt = (iso) => {
        if (!iso) return '-';
        try { return new Date(iso).toISOString().replace('T', ' ').substring(0, 19); }
        catch { return iso; }
    };
    const ageOf = (iso) => {
        if (!iso) return '-';
        const s = Math.max(0, Math.floor((Date.now() - new Date(iso).getTime()) / 1000));
        if (s < 90) return `${s}s`;
        if (s < 5400) return `${Math.floor(s / 60)}m`;
        if (s < 129600) return `${Math.floor(s / 3600)}h`;
        return `${Math.floor(s / 86400)}d`;
    };
    const ageStr = (s) => {
        if (s == null) return '-';
        if (s < 90) return `${s}s`;
        if (s < 5400) return `${Math.floor(s / 60)}m`;
        if (s < 129600) return `${Math.floor(s / 3600)}h`;
        return `${Math.floor(s / 86400)}d`;
    };

    // Tracks which row (by message id) is currently expanded per tab, so
    // an expansion survives the 5s snapshot poll re-rendering the table
    // out from under it (see detachExpanded/reattachExpanded below).
    const expandedIds = { outbound: null, inbox: null, dropped: null };

    // Fetches and renders (or collapses) the payload preview for `row`,
    // inserting it as a sibling <tr> directly below. Shared by the live
    // tab (whole row is the click target) and the outbound/inbox/dropped
    // tabs (just the id cell is the click target). `key` is the
    // expandedIds slot to track for tabs whose body gets replaced
    // wholesale by applyTabSnap; pass null for the live tab, whose rows
    // are appended in place and never bulk-replaced.
    async function togglePayload(tbody, row, colspan, key) {
        const id = row.dataset.id;
        const next = row.nextElementSibling;
        if (next && next.classList.contains('payload-row') && next.dataset.id === id) {
            next.remove();
            row.classList.remove('selected');
            if (key) expandedIds[key] = null;
            return;
        }
        tbody.querySelectorAll('tr.payload-row').forEach(r => r.remove());
        tbody.querySelectorAll('tr.selected').forEach(r => r.classList.remove('selected'));
        row.classList.add('selected');
        if (key) expandedIds[key] = id;
        const tr = document.createElement('tr');
        tr.className = 'payload-row';
        tr.dataset.id = id;
        tr.innerHTML = `<td colspan="${colspan}"><div class="payload-meta">loading payload for <code>${escape(id)}</code>...</div></td>`;
        row.parentNode.insertBefore(tr, row.nextSibling);
        try {
            const res = await fetch('@Url.Content("~/Events/payload/")' + encodeURIComponent(id), { credentials: 'same-origin' });
            if (res.status === 404) { tr.innerHTML = `<td colspan="${colspan}"><div class="payload-meta">payload for <code>${escape(id)}</code> not found - row may have been swept</div></td>`; return; }
            if (!res.ok) { tr.innerHTML = `<td colspan="${colspan}"><div class="payload-meta">payload fetch failed: HTTP ${res.status}</div></td>`; return; }
            const p = await res.json();
            const meta = `${p.byteLength} byte(s)` +
                (p.truncated ? ' - preview truncated' : '') +
                (p.textValid ? '' : ' - not valid UTF-8, showing hex') +
                ` - from <code>${escape(p.sourceCallsign)}</code>` +
                (via(p) ? ` via <code>${escape(p.viaCallsign)}</code>` : '') +
                ` - dst <code>${escape(p.destination)}</code>`;
            const showText = p.textValid;
            tr.innerHTML = `<td colspan="${colspan}">
                <div class="payload-meta">${meta}</div>
                <div class="payload-tabs">
                    <button type="button" data-mode="text" class="${showText ? 'active' : ''}" ${showText ? '' : 'disabled'}>text</button>
                    <button type="button" data-mode="hex" class="${showText ? '' : 'active'}">hex</button>
                </div>
                <pre data-mode="text" style="${showText ? '' : 'display:none;'}">${escape(p.text || '')}</pre>
                <pre data-mode="hex" style="${showText ? 'display:none;' : ''}">${escape(p.hex || '')}</pre>
            </td>`;
            tr.querySelectorAll('.payload-tabs button').forEach(btn => {
                btn.addEventListener('click', () => {
                    const mode = btn.dataset.mode;
                    tr.querySelectorAll('.payload-tabs button').forEach(b => b.classList.toggle('active', b === btn));
                    tr.querySelectorAll('pre').forEach(pre => pre.style.display = pre.dataset.mode === mode ? '' : 'none');
                });
            });
        } catch (e) {
            tr.innerHTML = `<td colspan="${colspan}"><div class="payload-meta">payload fetch failed: ${escape(e.message ?? e)}</div></td>`;
        }
    }

    // Outbound/inbox/dropped bodies are redrawn from scratch on every 5s
    // snapshot poll, which would otherwise silently collapse whatever the
    // operator had open. Lift the open preview row out before the redraw
    // and put the same DOM node back after it, so there is no re-fetch,
    // no "loading" flash, and the text/hex choice and scroll position
    // survive. If the message has left the table, the preview goes too.
    function detachExpanded(tbody) {
        const pr = tbody.querySelector('tr.payload-row');
        if (pr) pr.remove();
        return pr;
    }
    function reattachExpanded(tbody, key, payloadRow) {
        const id = expandedIds[key];
        if (!id || !payloadRow || payloadRow.dataset.id !== id) { expandedIds[key] = null; return; }
        const row = tbody.querySelector(`tr[data-id="${CSS.escape(id)}"]`);
        if (!row) { expandedIds[key] = null; return; }
        row.classList.add('selected');
        row.parentNode.insertBefore(payloadRow, row.nextSibling);
    }

    // Delegated click handler so a single listener on the tbody keeps
    // working across the wholesale innerHTML rebuilds done by
    // applyTabSnap - no need to rewire per-row listeners each poll.
    function wireIdClicks(tbody, colspan, key) {
        if (!tbody) return;
        tbody.addEventListener('click', (e) => {
            const link = e.target.closest('.msg-id-link');
            if (!link) return;
            const row = link.closest('tr');
            if (!row) return;
            togglePayload(tbody, row, colspan, key);
        });
    }
    wireIdClicks(document.getElementById('outbound-body'), 6, 'outbound');
    wireIdClicks(document.getElementById('inbox-body'), 8, 'inbox');

    // How long a message has left, from the residual TTL the snapshot
    // works out the same way the app API does (#389).
    const expiresStr = (s) => {
        if (s == null) return 'no expiry';
        if (s <= 0) return 'expiring now';
        const d = Math.floor(s / 86400), h = Math.floor((s % 86400) / 3600),
              m = Math.floor((s % 3600) / 60);
        if (d > 0) return `in ${d} d ${h} h`;
        if (h > 0) return `in ${h} h ${m} m`;
        if (m > 0) return `in ${m} m ${s % 60} s`;
        return `in ${s} s`;
    };

    // Drop button on the inbox (#389). One delegated listener, the id
    // read from the row's data- attribute, never from a handler built
    // out of message data (#317).
    const inboxBody = document.getElementById('inbox-body');
    if (inboxBody) {
        inboxBody.addEventListener('click', async (e) => {
            const btn = e.target.closest('button.drop-btn');
            if (!btn) return;
            const row = btn.closest('tr');
            const id = row?.dataset.id;
            if (!id) return;
            if (!confirm(`Drop message ${id}? Its app will never get it. It will be listed under Dropped.`)) return;
            const errBox = document.getElementById('inbox-error');
            errBox.hidden = true;
            btn.disabled = true;
            const form = new FormData();
            form.append('id', id);
            form.append('__RequestVerificationToken',
                document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '');
            try {
                const res = await fetch('@Url.Page("/Messages", "Drop")', {
                    method: 'POST', body: form, credentials: 'same-origin',
                });
                if (res.ok || res.status === 404) {
                    // Gone either way: dropped now, or already gone.
                    const next = row.nextElementSibling;
                    if (next && next.classList.contains('payload-row') && next.dataset.id === id) next.remove();
                    if (expandedIds.inbox === id) expandedIds.inbox = null;
                    row.remove();
                    return;
                }
                errBox.textContent = `Could not drop ${id}: ` + (await res.text() || `HTTP ${res.status}`);
                errBox.hidden = false;
            } catch (err) {
                errBox.textContent = `Could not drop ${id}: ${err.message ?? err}`;
                errBox.hidden = false;
            }
            btn.disabled = false;
        });
    }
    wireIdClicks(document.getElementById('dropped-body'), 5, 'dropped');

    function applyTabSnap(s) {
        // Update tab counters from snapshot regardless of which tab is open
        const dropped = (s.tables?.dropped ?? []);
        const out = (s.tables?.outbound ?? []);
        const inb = (s.tables?.localInbox ?? []);
        const setCount = (id, n) => { const el = document.getElementById(id); if (el) el.textContent = n; };
        setCount('cnt-outbound', out.length);
        setCount('cnt-inbox', inb.length);
        setCount('cnt-dropped', dropped.length);

        if (tab === 'outbound') {
            const body = document.getElementById('outbound-body');
            if (!body) return;
            if (out.length === 0) {
                body.innerHTML = '<tr><td colspan="6" class="muted" style="text-align:center;">queue is empty</td></tr>';
                return;
            }
            const openRow = detachExpanded(body);
            body.innerHTML = out.map(m =>
                `<tr data-id="${escape(m.id)}">`
                + `<td><code class="msg-id-link" title="click to view payload">${escape(m.id)}</code></td>`
                + `<td><code>${escape(m.destination)}</code></td>`
                + `<td>${fromCell(m)}</td>`
                + `<td class="numeric">${m.bytes ?? '-'}</td>`
                + `<td>${ageStr(m.ageSeconds)}</td>`
                + '<td><span class="pill">queued</span></td>'
                + '</tr>'
            ).join('');
            reattachExpanded(body, 'outbound', openRow);
        }
        if (tab === 'inbox') {
            const body = document.getElementById('inbox-body');
            if (!body) return;
            if (inb.length === 0) {
                body.innerHTML = '<tr><td colspan="8" class="muted" style="text-align:center;">inbox is empty</td></tr>';
                return;
            }
            const openRow = detachExpanded(body);
            body.innerHTML = inb.map(m =>
                `<tr data-id="${escape(m.id)}">`
                + `<td><code class="msg-id-link" title="click to view payload">${escape(m.id)}</code></td>`
                + `<td><code>${escape(m.destination)}</code></td>`
                + `<td>${fromCell(m)}</td>`
                + `<td class="numeric">${m.bytes ?? '-'}</td>`
                + `<td>${ageStr(m.ageSeconds)}</td>`
                + `<td class="ttl-left">${escape(expiresStr(m.ttlRemaining))}</td>`
                + '<td><span class="pill warn">awaiting ack</span></td>'
                + '<td><button type="button" class="btn ghost sm drop-btn" title="drop this message; its app will never get it">Drop</button></td>'
                + '</tr>'
            ).join('');
            reattachExpanded(body, 'inbox', openRow);
        }
        if (tab === 'dropped') {
            const body = document.getElementById('dropped-body');
            if (!body) return;
            if (dropped.length === 0) {
                body.innerHTML = '<tr><td colspan="5" class="muted" style="text-align:center;">no recent drops</td></tr>';
                return;
            }
            const openRow = detachExpanded(body);
            body.innerHTML = dropped.map(m =>
                `<tr data-id="${escape(m.id)}">`
                + `<td><code class="msg-id-link" title="click to view payload">${escape(m.id)}</code></td>`
                + `<td><code>${escape(m.destination)}</code></td>`
                + `<td>${fromCell(m)}</td>`
                + `<td>${escape(m.reason ?? '-')}</td>`
                + `<td>${fmtAt(m.droppedAt)}</td>`
                + '</tr>'
            ).join('');
            reattachExpanded(body, 'dropped', openRow);
        }
    }

    if (window.__dappsSnap) applyTabSnap(window.__dappsSnap);
    if (window.dappsOnSnap) window.dappsOnSnap(applyTabSnap);

    // -- Live tab: SSE bridge --
    if (tab === 'live') {
        const tbody = document.getElementById('inbound-body');
        const status = document.getElementById('sse-state');
        const counter = document.getElementById('inbound-count');
        const fApp = document.getElementById('filter-app');
        const fCall = document.getElementById('filter-callsign');
        const fDest = document.getElementById('filter-dest');
        const fSummary = document.getElementById('filter-summary');
        const fClear = document.getElementById('filter-clear');
        let count = 0;
        let cleared = false;

        const appOf = (dest) => {
            const at = String(dest ?? '').indexOf('@@');
            return at > 0 ? String(dest).substring(0, at) : String(dest ?? '');
        };
        const matchesFilter = (row) => {
            const a = (fApp.value || '').trim().toLowerCase();
            const c = (fCall.value || '').trim().toLowerCase();
            const d = (fDest.value || '').trim().toLowerCase();
            if (a && !appOf(row.dataset.dest).toLowerCase().includes(a)) return false;
            if (c && !row.dataset.src.toLowerCase().includes(c)) return false;
            if (d && !row.dataset.dest.toLowerCase().includes(d)) return false;
            return true;
        };
        const applyFilters = () => {
            let visible = 0;
            for (const tr of tbody.querySelectorAll('tr.inbound-row')) {
                const show = matchesFilter(tr);
                tr.style.display = show ? '' : 'none';
                const next = tr.nextElementSibling;
                if (next && next.classList.contains('payload-row')) next.style.display = show ? '' : 'none';
                if (show) visible += 1;
            }
            const anyFilter = (fApp.value || fCall.value || fDest.value).trim().length > 0;
            fSummary.textContent = anyFilter
                ? `showing ${visible} of ${tbody.querySelectorAll('tr.inbound-row').length} rows`
                : 'showing all rows';
        };
        fApp.addEventListener('input', applyFilters);
        fCall.addEventListener('input', applyFilters);
        fDest.addEventListener('input', applyFilters);
        fClear.addEventListener('click', () => { fApp.value = ''; fCall.value = ''; fDest.value = ''; applyFilters(); });

        const es = new EventSource('@Url.Content("~/Events/inbound")');
        es.onopen = () => { status.textContent = 'live'; status.className = 'pill ok'; };
        es.onerror = () => { status.textContent = 'reconnecting'; status.className = 'pill warn'; };
        es.addEventListener('inbound', (ev) => {
            if (!cleared) { tbody.innerHTML = ''; cleared = true; }
            try {
                const d = JSON.parse(ev.data);
                const row = document.createElement('tr');
                row.className = 'inbound-row';
                row.dataset.id = d.id;
                row.dataset.src = [d.sourceCallsign, d.viaCallsign].filter(Boolean).join(' ');
                row.dataset.dest = d.destination ?? '';
                row.innerHTML =
                    '<td>' + escape(fmtAt(d.receivedAt)) + '</td>' +
                    '<td><code>' + escape(d.id) + '</code></td>' +
                    '<td>' + fromCell(d) + '</td>' +
                    '<td>' + escape(d.destination) + '</td>' +
                    '<td class="numeric">' + escape(d.payloadLength) + '</td>' +
                    '<td class="numeric">' + (d.ttl == null ? '-' : escape(d.ttl)) + '</td>';
                row.addEventListener('click', () => togglePayload(tbody, row, 6, null));
                if (!matchesFilter(row)) row.style.display = 'none';
                tbody.insertBefore(row, tbody.firstChild);
                count += 1; counter.textContent = count;
                while (tbody.querySelectorAll('tr.inbound-row').length > 500) {
                    const last = [...tbody.querySelectorAll('tr.inbound-row')].pop();
                    const sib = last.nextElementSibling;
                    if (sib && sib.classList.contains('payload-row')) sib.remove();
                    last.remove();
                }
                applyFilters();
            } catch (e) { console.error('inbound parse failed', e); }
        });
    }
})();
</script>
