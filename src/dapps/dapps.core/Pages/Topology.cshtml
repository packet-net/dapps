@page
@model TopologyModel
@{
    ViewData["Title"] = $"DAPPS - topology ({Model.Options.Callsign})";
    ViewData["Active"] = "topology";
    ViewData["PageTitle"] = "Topology";
    ViewData["PageSubtitle"] = "Neighbours, discovery channels, peers heard, and connectivity state.";
    var tab = Model.Tab;
}

@section Tabs {
    <a href="~/Topology?tab=neighbours" class="@(tab == "neighbours" ? "active" : "")">Neighbours <span class="count" id="cnt-neigh">0</span></a>
    <a href="~/Topology?tab=channels" class="@(tab == "channels" ? "active" : "")">Discovery channels <span class="count" id="cnt-chan">0</span></a>
    <a href="~/Topology?tab=peers" class="@(tab == "peers" ? "active" : "")">Discovered peers <span class="count" id="cnt-peers">0</span></a>
    <a href="~/Topology?tab=probes" class="@(tab == "probes" ? "active" : "")">Probed nodes <span class="count" id="cnt-probes">0</span></a>
    <a href="~/Topology?tab=polls" class="@(tab == "polls" ? "active" : "")">Polled nodes <span class="count" id="cnt-polls">0</span></a>
}

@if (tab == "neighbours")
{
    <div class="panel">
        <h3>Manual neighbours</h3>
        <p class="panel-sub">DAPPS nodes this node sends messages to. Most need only a callsign and a radio port.</p>
        <form id="neigh-form" class="row-form neigh-form" onsubmit="dappsAddNeighbour(event)" style="margin-bottom: 1rem;">
            <div class="field"><label>Callsign</label><input name="callsign" placeholder="GB7XYZ-3" required />
                <span class="hint">the peer's DAPPS callsign, with SSID</span>
            </div>
            <div class="field"><label>Connect via (optional)</label><input name="connectVia" placeholder="GB7ABC" />
                <span class="hint">only if the peer can't be dialled directly: the node to dial instead</span>
            </div>
            <div class="field" data-port-picker="bearerPort">
                <label>Radio port</label>
                <select name="bearerPort">
                    <option value="">(default - port @Model.Options.DefaultBearerPort)</option>
                </select>
                <span class="hint" data-port-picker-hint>loading from BPQ...</span>
            </div>
            <div class="field span-all">
                <label>Connect script (optional)</label>
                <textarea name="connectScript" rows="3" placeholder="C 1 GB7XYZ-3|DAPPSv1>|60"></textarea>
                <span class="hint">what to type at that node's prompt to reach the peer, one step per line: <code>command|reply to wait for</code></span>
                <details class="help">
                    <summary>How connect scripts work</summary>
                    <ul>
                        <li><code>C 1 GB7XYZ-3|Connected</code> sends the command, then waits for "Connected" in the reply.</li>
                        <li>Add <code>|60</code> to wait up to 60 seconds for the reply (30 if left out).</li>
                        <li>The last line must wait for <code>DAPPSv1&gt;</code>, the peer's DAPPS prompt.</li>
                        <li>Don't include the connect to the Connect via node; DAPPS has already made it. With Connect via blank the script runs at the Callsign's own prompt, except that a first line <code>C &lt;node&gt;</code> (no port number) is moved into Connect via when you save.</li>
                        <li>Empty the box to clear the script. <a href="https://packet-net.github.io/dapps/multi-hop/" target="_blank" rel="noopener">Manual: reaching a peer through other nodes</a>.</li>
                    </ul>
                </details>
            </div>
            <div class="field"><label>UDP endpoint (optional)</label><input name="udpEndpoint" placeholder="host:port" />
                <span class="hint">test only: reach this peer over UDP</span>
            </div>
            <div class="field"><label>Compression</label>
                <select name="compression">
                    <option value="">Default</option>
                    <option value="off">Off</option>
                    <option value="on">On</option>
                </select>
                <span class="hint">overrides Settings for this peer</span>
            </div>
            <div class="field"><label>Link hold (s)</label>
                <input name="sessionTail" type="number" min="0" max="600" placeholder="default" />
                <span class="hint">blank = as Settings, 0 = off</span>
            </div>
            <div class="span-all neigh-actions">
                <button class="btn ghost" type="button" id="neigh-cancel" onclick="dappsCancelEditNeighbour()" style="display: none;">Cancel</button>
                <button class="btn" type="submit">Add / update</button>
            </div>
        </form>
        <table>
            <thead>
                <tr><th>Callsign</th><th>Port</th><th>UDP</th><th>Compression</th><th>Hold</th><th>Script</th><th></th></tr>
            </thead>
            <tbody id="neigh-body"><tr><td colspan="7" class="muted" style="text-align:center;">loading</td></tr></tbody>
        </table>
    </div>
}
else if (tab == "channels")
{
    <div class="panel">
        <h3>Discovery channels</h3>
        <p class="panel-sub">Where DAPPS beacons and listens for other DAPPS nodes. Nothing beacons until you add one.</p>
        <details class="help">
            <summary>How channels work</summary>
            <ul>
                <li>The link class sets the routing cost and, unless you set Beacon every, the cadence: every 30 minutes on VHF/UHF FM, hourly on MeshCore, every 2 hours on HF.</li>
                <li>The airtime budget caps this channel's transmissions per hour; 0 means only the overall budget in Settings applies.</li>
                <li>Changes take effect within about 10 seconds. If the packet node is down, DAPPS keeps retrying it.</li>
                <li>A solicit asks "who's there?" and listens for replies; useful on HF where beaconing is dear.</li>
                <li><a href="https://packet-net.github.io/dapps/discovery-and-routing/" target="_blank" rel="noopener">Manual: discovery and routing</a>.</li>
            </ul>
        </details>
        <form id="chan-form" class="row-form" onsubmit="dappsAddChannel(event)" style="margin-bottom: 1rem; align-items: start;">
            <div class="field"><label>Bearer</label>
                <select name="bearer">
                    <option value="agw">agw</option>
                    <option value="udp">udp</option>
                </select>
            </div>
            <div class="field" id="chan-channelKey-field">
                <label>Port or address</label>
                <!-- Replaced on page load + on bearer-dropdown change.
                     For AGW: a <select> populated from /Bearer/agw/ports.
                     For UDP: a free-text <input> for the multicast addr. -->
                <div id="chan-channelKey-control"></div>
                <span class="hint" id="chan-channelKey-hint"></span>
            </div>
            <div class="field"><label>Link class</label>
                <select name="linkClass">
                    <option value="VhfUhfFm">VHF/UHF FM</option>
                    <option value="MeshCore">MeshCore</option>
                    <option value="Hf">HF</option>
                    <option value="LanMulticast">LAN multicast (testing)</option>
                    <option value="InternetIp">Internet IP</option>
                </select>
                <span class="hint">sets the routing cost and the default cadence</span>
            </div>
            <div class="field"><label>Beacon every (minutes)</label><input name="beaconMinutes" type="number" min="1" max="1440" placeholder="default" />
                <span class="hint">blank = the link class default</span></div>
            <div class="field"><label>Airtime budget (s/h, 0 = unlimited)</label><input name="airtimeBudgetSecondsPerHour" type="number" min="0" max="3600" value="0" /></div>
            <div class="field"><label>Solicit interval (s, 0 = off)</label><input name="solicitIntervalSeconds" type="number" min="0" max="86400" value="0" /></div>
            <label class="field-checkbox" style="align-self: center;"><input name="enabled" type="checkbox" checked /><span>Enabled</span></label>
            <div style="grid-column: 1 / -1; display: flex; justify-content: flex-end; gap: 0.5rem;">
                <button class="btn ghost" type="button" id="chan-cancel" onclick="dappsCancelEditChannel()" style="display: none;">Cancel</button>
                <button class="btn" type="submit">Add / update</button>
            </div>
        </form>
        <table>
            <thead>
                <tr>
                    <th>Bearer</th><th>Port / address</th><th>Class</th>
                    <th class="numeric">Cost</th><th class="numeric">Beacon</th><th class="numeric">TTL</th>
                    <th class="numeric">Budget</th><th class="numeric">Solicit</th><th>Enabled</th><th></th>
                </tr>
            </thead>
            <tbody id="chan-body"><tr><td colspan="10" class="muted" style="text-align:center;">loading</td></tr></tbody>
        </table>
    </div>
}
else if (tab == "peers")
{
    <div class="panel">
        <h3>Discovered peers</h3>
        <p class="panel-sub">DAPPS nodes heard beaconing or answering a solicit. Forgotten when their advertised TTL runs out.</p>
        <table>
            <thead>
                <tr><th>Callsign</th><th>Bearer</th><th>Channel</th><th class="numeric">Hops</th><th class="numeric">Cost</th><th>Last seen</th></tr>
            </thead>
            <tbody id="peer-body"><tr><td colspan="6" class="muted" style="text-align:center;">loading</td></tr></tbody>
        </table>
    </div>
}
else if (tab == "probes")
{
    <div class="panel">
        <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem;">
            <div>
                <h3>Probed nodes</h3>
                <p class="panel-sub">Whether each known peer answered a check call. Scheduled in Settings, or press a probe button.</p>
            </div>
            <div class="card-actions" style="margin-top: 0;">
                <button class="btn secondary sm" type="button" onclick="dappsRunSweep()">Probe everyone now</button>
            </div>
        </div>
        <table>
            <thead>
                <tr><th>Callsign</th><th>Source</th><th class="numeric">Port</th><th>Last probed</th><th>Last success</th><th class="numeric">Failures</th><th>Last error</th><th>Opt-out</th><th></th></tr>
            </thead>
            <tbody id="probe-body"><tr><td colspan="9" class="muted" style="text-align:center;">loading</td></tr></tbody>
        </table>
    </div>
}
else
{
    <div class="panel">
        <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem;">
            <div>
                <h3>Polled nodes</h3>
                <p class="panel-sub">Calls to each neighbour to collect mail held for us. Off unless turned on in Settings.</p>
            </div>
            <div class="card-actions" style="margin-top: 0;">
                <button class="btn secondary sm" type="button" onclick="dappsRunPollSweep()">Poll everyone now</button>
            </div>
        </div>
        <table>
            <thead>
                <tr><th>Callsign</th><th>Last polled</th><th>Last success</th><th class="numeric">Failures</th><th class="numeric">Drained</th><th>Last error</th><th>Opt-out</th><th></th></tr>
            </thead>
            <tbody id="poll-body"><tr><td colspan="8" class="muted" style="text-align:center;">loading</td></tr></tbody>
        </table>
    </div>
}

<script>
(function () {
    const tab = '@tab';
    const defaultPort = @Model.Options.DefaultBearerPort;
    const escape = (s) => String(s ?? '').replace(/[&<>"']/g, c =>
        ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    const fmtAt = (iso) => {
        if (!iso) return '-';
        try { return new Date(iso).toISOString().replace('T', ' ').substring(0, 19); }
        catch { return iso; }
    };
    const fmtAgo = (iso) => {
        if (!iso) return '-';
        const s = Math.max(0, Math.floor((Date.now() - new Date(iso).getTime()) / 1000));
        if (s < 90) return `${s}s ago`;
        if (s < 5400) return `${Math.floor(s / 60)}m ago`;
        if (s < 129600) return `${Math.floor(s / 3600)}h ago`;
        return `${Math.floor(s / 86400)}d ago`;
    };

    function setCount(id, n) { const el = document.getElementById(id); if (el) el.textContent = n; }

    // -- Shared AGW port query --
    // Cached for the lifetime of the page so the neighbour form and
    // the channel form share one round-trip to BPQ instead of two.
    // Returns { ports: [{index, description}, ...] } on success, or
    // { error: '...' } when /Bearer/agw/ports answers !ok or throws.
    let __dappsAgwPortsPromise = null;
    function loadAgwPorts(force = false) {
        if (force || __dappsAgwPortsPromise == null) {
            __dappsAgwPortsPromise = (async () => {
                try {
                    const res = await fetch('@Url.Content("~/Bearer/agw/ports")', { credentials: 'same-origin' });
                    if (!res.ok) return { error: (await res.text()) || `HTTP ${res.status}` };
                    const ports = await res.json();
                    // Expose an index->description map so the
                    // neighbours/channels tables can show "Port 0 (VHF
                    // FM 1200)" instead of just "0".
                    const map = {};
                    for (const p of ports) map[p.index] = p.description;
                    window.__dappsAgwPortMap = map;
                    return { ports };
                } catch (e) { return { error: e.message ?? String(e) }; }
            })();
        }
        return __dappsAgwPortsPromise;
    }
    // Kick off the port query early so the snap-driven table renders
    // can already see __dappsAgwPortMap on first paint.
    loadAgwPorts();

    async function dappsPostJson(url, body, method) {
        const res = await fetch(url, {
            method: method || 'POST',
            headers: { 'content-type': 'application/json' },
            body: body == null ? null : JSON.stringify(body),
        });
        if (!res.ok && res.status !== 204) {
            const text = await res.text();
            alert(`Request failed (${res.status}): ${text}`);
            return false;
        }
        return true;
    }

    window.dappsAddNeighbour = async (ev) => {
        ev.preventDefault();
        const f = ev.target;
        const compression = { '': null, 'off': false, 'on': true }[f.compression.value] ?? null;
        const body = {
            Callsign: f.callsign.value,
            BearerPort: f.bearerPort.value === '' ? null : parseInt(f.bearerPort.value, 10),
            UdpEndpoint: f.udpEndpoint.value || null,
            ConnectScript: f.connectScript.value || null,
            ConnectVia: f.connectVia.value || null,
            CompressionEnabled: compression,
            SessionTailSeconds: f.sessionTail.value === '' ? null : parseInt(f.sessionTail.value, 10),
        };
        if (await dappsPostJson('@Url.Content("~/Neighbours")', body)) location.reload();
    };
    // Connect-scripts arrive as the stored JSON; render them back into
    // the send|expect[|timeout] lines the form takes.
    function connectScriptLines(json) {
        if (!json) return '';
        try {
            const steps = JSON.parse(json).steps ?? [];
            return steps.map(st => st.timeoutSeconds != null
                ? `${st.send}|${st.expect}|${st.timeoutSeconds}`
                : `${st.send}|${st.expect}`).join('\n');
        } catch { return ''; }
    }
    window.dappsEditNeighbour = async (callsign) => {
        const n = (window.__dappsNeighbours || []).find(x => x.callsign === callsign);
        const f = document.getElementById('neigh-form');
        if (!n || !f) return;
        f.callsign.value = n.callsign;
        // The same callsign is what makes the POST an update, so lock it.
        f.callsign.readOnly = true;
        f.udpEndpoint.value = n.udpEndpoint || '';
        f.compression.value = n.compressionEnabled == null ? '' : (n.compressionEnabled ? 'on' : 'off');
        f.sessionTail.value = n.sessionTailSeconds == null ? '' : String(n.sessionTailSeconds);
        f.connectScript.value = connectScriptLines(n.connectScriptJson);
        f.connectVia.value = n.connectVia || '';
        // The port picker may still be filling from BPQ (or swapping to a
        // text input); wait for it so the saved port can be selected.
        await loadAgwPorts();
        const port = f.bearerPort;
        const value = n.bearerPort == null ? '' : String(n.bearerPort);
        if (port.tagName === 'SELECT' && ![...port.options].some(o => o.value === value)) {
            const opt = document.createElement('option');
            opt.value = value;
            opt.textContent = `Port ${value}`;
            port.appendChild(opt);
        }
        port.value = value;
        f.querySelector('button[type="submit"]').textContent = `Save ${n.callsign}`;
        document.getElementById('neigh-cancel').style.display = '';
        f.scrollIntoView({ behavior: 'smooth', block: 'start' });
        f.connectScript.focus();
    };
    window.dappsCancelEditNeighbour = () => {
        const f = document.getElementById('neigh-form');
        f.reset();
        f.callsign.readOnly = false;
        f.querySelector('button[type="submit"]').textContent = 'Add / update';
        document.getElementById('neigh-cancel').style.display = 'none';
    };
    window.dappsDeleteNeighbour = async (callsign) => {
        if (!confirm(`Remove neighbour ${callsign}?`)) return;
        if (await dappsPostJson('@Url.Content("~/Neighbours/")' + encodeURIComponent(callsign), null, 'DELETE')) location.reload();
    };
    // The snapshot serialises LinkClass as its number; the API wants the
    // name. Map either form to the name and to a readable label.
    const LINK_CLASSES = ['Unknown', 'VhfUhfFm', 'MeshCore', 'Hf', 'LanMulticast', 'InternetIp'];
    const LINK_LABELS = { Unknown: 'unknown', VhfUhfFm: 'VHF/UHF FM', MeshCore: 'MeshCore', Hf: 'HF', LanMulticast: 'LAN multicast', InternetIp: 'Internet IP' };
    const linkClassName = (v) => typeof v === 'number' ? (LINK_CLASSES[v] ?? 'Unknown') : String(v ?? 'Unknown');
    const linkClassLabel = (v) => LINK_LABELS[linkClassName(v)] ?? linkClassName(v);
    // Default cadence per class, as LinkClassDefaults.BeaconIntervalSeconds.
    const CLASS_CADENCE = { Unknown: 1800, VhfUhfFm: 1800, MeshCore: 3600, Hf: 7200, LanMulticast: 60, InternetIp: 300 };
    // The upsert is keyed on (bearer, channel key); a zero for cadence,
    // TTL or cost means "the link class default". TTL and cost have no
    // form field, so an edit carries the row's values through
    // unchanged via the form's dataset.
    window.dappsAddChannel = async (ev) => {
        ev.preventDefault();
        const f = ev.target;
        const minutes = parseInt(f.beaconMinutes.value, 10);
        let seconds = minutes > 0 ? minutes * 60 : 0;
        let ttl = parseInt(f.dataset.ttl ?? '0', 10) || 0;
        let cost = parseInt(f.dataset.cost ?? '0', 10) || 0;
        // A class change on an edit takes the new class's defaults for
        // whatever was still at the old class's defaults.
        const origClass = f.dataset.origClass;
        if (origClass && origClass !== f.linkClass.value) {
            ttl = 0; cost = 0;
            if (seconds === (CLASS_CADENCE[origClass] ?? -1)) seconds = 0;
        }
        const body = {
            Bearer: f.bearer.value,
            ChannelKey: f.channelKey.value,
            LinkClass: f.linkClass.value,
            BeaconIntervalSeconds: seconds,
            AdvertisedTtlSeconds: ttl,
            CostHint: cost,
            Enabled: f.enabled.checked,
            Notes: f.dataset.notes ?? null,
            AirtimeBudgetSecondsPerHour: parseInt(f.airtimeBudgetSecondsPerHour.value, 10) || 0,
            SolicitIntervalSeconds: parseInt(f.solicitIntervalSeconds.value, 10) || 0,
        };
        if (await dappsPostJson('@Url.Content("~/DiscoveryChannels")', body)) location.reload();
    };
    window.dappsEditChannel = async (id) => {
        const c = (window.__dappsChannels || []).find(x => x.id === id);
        const f = document.getElementById('chan-form');
        if (!c || !f) return;
        f.bearer.value = c.bearer;
        if (window.__dappsChanRender) await window.__dappsChanRender();
        const key = f.channelKey;
        if (key.tagName === 'SELECT' && ![...key.options].some(o => o.value === String(c.channelKey))) {
            const opt = document.createElement('option');
            opt.value = String(c.channelKey);
            opt.textContent = `Port ${c.channelKey}`;
            key.appendChild(opt);
        }
        key.value = c.channelKey;
        // Bearer and key identify the row, so lock them while editing.
        f.bearer.disabled = true;
        if (key.tagName === 'SELECT') key.disabled = true; else key.readOnly = true;
        f.linkClass.value = linkClassName(c.linkClass);
        f.dataset.origClass = linkClassName(c.linkClass);
        f.beaconMinutes.value = c.beaconIntervalSeconds > 0 ? String(Math.min(1440, Math.max(1, Math.round(c.beaconIntervalSeconds / 60)))) : '';
        f.airtimeBudgetSecondsPerHour.value = String(c.airtimeBudgetSecondsPerHour ?? 0);
        f.solicitIntervalSeconds.value = String(c.solicitIntervalSeconds ?? 0);
        f.enabled.checked = !!c.enabled;
        f.dataset.ttl = String(c.advertisedTtlSeconds ?? 0);
        f.dataset.cost = String(c.costHint ?? 0);
        if (c.notes != null) f.dataset.notes = c.notes;
        f.querySelector('button[type="submit"]').textContent = `Save ${c.bearer} ${c.channelKey}`;
        document.getElementById('chan-cancel').style.display = '';
        f.scrollIntoView({ behavior: 'smooth', block: 'start' });
        f.beaconMinutes.focus();
    };
    window.dappsCancelEditChannel = () => {
        const f = document.getElementById('chan-form');
        f.reset();
        f.bearer.disabled = false;
        const key = f.channelKey;
        if (key) { key.disabled = false; key.readOnly = false; }
        delete f.dataset.ttl; delete f.dataset.cost; delete f.dataset.notes; delete f.dataset.origClass;
        f.querySelector('button[type="submit"]').textContent = 'Add / update';
        document.getElementById('chan-cancel').style.display = 'none';
        // reset() put the bearer back without a change event; redraw
        // the key control to match it.
        window.__dappsChanRender?.();
    };
    window.dappsSetChannelEnabled = async (id, enabled) => {
        const c = (window.__dappsChannels || []).find(x => x.id === id);
        if (!c) return;
        const body = {
            Bearer: c.bearer,
            ChannelKey: c.channelKey,
            LinkClass: linkClassName(c.linkClass),
            BeaconIntervalSeconds: c.beaconIntervalSeconds,
            AdvertisedTtlSeconds: c.advertisedTtlSeconds,
            CostHint: c.costHint,
            Enabled: enabled,
            Notes: c.notes ?? null,
            AirtimeBudgetSecondsPerHour: c.airtimeBudgetSecondsPerHour,
            SolicitIntervalSeconds: c.solicitIntervalSeconds,
        };
        if (await dappsPostJson('@Url.Content("~/DiscoveryChannels")', body)) await window.dappsRefreshSnap?.();
    };
    window.dappsDeleteChannel = async (id) => {
        if (!confirm(`Remove discovery channel ${id}?`)) return;
        if (await dappsPostJson('@Url.Content("~/DiscoveryChannels/")' + id, null, 'DELETE')) location.reload();
    };
    window.dappsSolicitChannel = async (id) => {
        await dappsPostJson('@Url.Content("~/DiscoveryChannels/")' + id + '/solicit', null);
    };
    window.dappsRunSweep = async () => {
        if (!confirm('Probe every known peer now? Uses other operators\' airtime.')) return;
        if (await dappsPostJson('@Url.Content("~/Probes/run")', null)) await window.dappsRefreshSnap?.();
    };
    window.dappsProbeOne = async (callsign) => {
        const res = await fetch('@Url.Content("~/Probes/run/")' + callsign, { method: 'POST' });
        if (!res.ok && res.status !== 200 && res.status !== 204) {
            alert(`Probe failed (${res.status}): ${await res.text()}`);
            return;
        }
        await window.dappsRefreshSnap?.();
    };
    window.dappsSetOptOut = async (callsign, optOut) => {
        await dappsPostJson('@Url.Content("~/Probes/")' + callsign + '/optout', { OptOut: optOut });
    };
    window.dappsForgetProbe = async (callsign) => {
        if (!confirm(`Forget probe row for ${decodeURIComponent(callsign)}?`)) return;
        if (await dappsPostJson('@Url.Content("~/Probes/")' + callsign, null, 'DELETE')) await window.dappsRefreshSnap?.();
    };
    window.dappsRunPollSweep = async () => {
        if (!confirm('Poll every neighbour for queued mail now?')) return;
        if (await dappsPostJson('@Url.Content("~/Polls/run")', null)) await window.dappsRefreshSnap?.();
    };
    window.dappsPollOne = async (callsign) => {
        const res = await fetch('@Url.Content("~/Polls/run/")' + callsign, { method: 'POST' });
        if (!res.ok && res.status !== 200 && res.status !== 204) {
            alert(`Poll failed (${res.status}): ${await res.text()}`);
            return;
        }
        await window.dappsRefreshSnap?.();
    };
    window.dappsSetPollOptOut = async (callsign, optOut) => {
        await dappsPostJson('@Url.Content("~/Polls/")' + callsign + '/optout', { OptOut: optOut });
    };
    window.dappsForgetPoll = async (callsign) => {
        if (!confirm(`Forget poll row for ${decodeURIComponent(callsign)}?`)) return;
        if (await dappsPostJson('@Url.Content("~/Polls/")' + callsign, null, 'DELETE')) await window.dappsRefreshSnap?.();
    };

    // -- Port-picker bootstraps for the per-tab forms --
    if (tab === 'neighbours') {
        // Replace the "(default - port 0)" placeholder with the real
        // BPQ port list. Falls back gracefully if AGW isn't available
        // (e.g. RHPv2 bearer): we surface the error in the hint and
        // swap the <select> for a free-text port-number input so the
        // operator isn't stuck.
        (async () => {
            const wrap = document.querySelector('#neigh-form [data-port-picker="bearerPort"]');
            if (!wrap) return;
            const select = wrap.querySelector('select');
            const hint = wrap.querySelector('[data-port-picker-hint]');
            const r = await loadAgwPorts();
            if (r.error) {
                wrap.innerHTML = `<label>Radio port</label>
                    <input name="bearerPort" type="number" min="0" max="255" placeholder="0" />
                    <span class="hint">${/not AGW/.test(r.error)
                        ? 'the node\'s port number, counting from 0: its first port is 0'
                        : `can't list BPQ's ports (${escape(r.error).replace(/\.$/, '')}); type the port number, counting from 0`}</span>`;
                return;
            }
            for (const p of r.ports) {
                const opt = document.createElement('option');
                opt.value = String(p.index);
                opt.textContent = `Port ${p.index} - ${p.description}`;
                select.appendChild(opt);
            }
            hint.textContent = `${r.ports.length} port${r.ports.length === 1 ? '' : 's'} from BPQ. Default is port ${defaultPort}.`;
        })();
    }

    if (tab === 'channels') {
        // Channel key changes shape with the bearer dropdown:
        //   AGW -> dropdown of BPQ-advertised radio ports
        //   UDP -> free-text input for the multicast addr (host:port)
        // Re-renders the inner control on every bearer change so the
        // form always submits a sensibly-shaped channelKey value.
        (async () => {
            const bearerSel = document.querySelector('#chan-form select[name="bearer"]');
            const wrap = document.getElementById('chan-channelKey-control');
            const hint = document.getElementById('chan-channelKey-hint');
            if (!bearerSel || !wrap || !hint) return;

            async function render() {
                const bearer = (bearerSel.value || 'agw').toLowerCase();
                if (bearer === 'udp') {
                    wrap.innerHTML = `<input name="channelKey" required placeholder="239.0.0.1:54321" />`;
                    hint.textContent = 'multicast address and port, e.g. 239.0.0.1:54321';
                    return;
                }
                // AGW path - show port dropdown.
                const r = await loadAgwPorts();
                if (r.error) {
                    wrap.innerHTML = `<input name="channelKey" type="number" min="0" max="255" required placeholder="0" />`;
                    hint.textContent = /not AGW/.test(r.error)
                        ? 'the node\'s port number, counting from 0: its first port is 0'
                        : `can't list BPQ's ports (${r.error.replace(/\.$/, '')}); type the port number, counting from 0`;
                    return;
                }
                const opts = r.ports.map(p =>
                    `<option value="${p.index}">Port ${p.index} - ${escape(p.description)}</option>`).join('');
                wrap.innerHTML = `<select name="channelKey" required>
                    <option value="">(pick a port)</option>
                    ${opts}
                </select>`;
                hint.textContent = `${r.ports.length} port${r.ports.length === 1 ? '' : 's'} from BPQ`;
            }

            bearerSel.addEventListener('change', render);
            window.__dappsChanRender = render;
            render();
        })();
    }

    function apply(s) {
        const t = s.tables ?? {};
        setCount('cnt-neigh', (t.neighbours || []).length);
        setCount('cnt-chan',  (t.discoveryChannels || []).length);
        setCount('cnt-peers', (t.discoveredPeers || []).length);
        setCount('cnt-probes',(t.probedNodes || []).length);
        setCount('cnt-polls', (t.polledNodes || []).length);

        if (tab === 'neighbours') {
            const body = document.getElementById('neigh-body');
            const ns = t.neighbours || [];
            window.__dappsNeighbours = ns;
            // Resolve port descriptions if BPQ's port list has loaded;
            // otherwise just show the index. Best-effort - the table
            // refreshes every snap so a later resolve will pick up.
            const portMap = window.__dappsAgwPortMap || {};
            const fmtPort = (idx) => {
                if (idx == null) return '<span class="muted">default</span>';
                const desc = portMap[idx];
                return desc ? `${idx} <span class="muted">(${escape(desc)})</span>` : String(idx);
            };
            const fmtCompression = (c) => c == null ? '<span class="muted">default</span>' : (c ? 'on' : 'off');
            const fmtHold = (s) => s == null ? '<span class="muted">default</span>' : (s === 0 ? 'off' : String(s));
            // Routing matches a neighbour by callsign and SSID; one entered
            // with another SSID still works, standing in for the station
            // it was meant for, but is worth tidying (#242).
            const station = (c) => c.trim().toUpperCase().replace(/-0$/, '');
            const callOf = (c) => station(c).split('-')[0];
            const heard = t.discoveredPeers || [];
            const ssidNote = (n) => {
                if (heard.some(p => station(p.callsign) === station(n.callsign))) return '';
                const other = heard.find(p => callOf(p.callsign) === callOf(n.callsign)
                    && !ns.some(x => station(x.callsign) === station(p.callsign)));
                if (other) return `<div class="muted"><span class="pill warn">SSID?</span> heard as <code>${escape(other.callsign)}</code>; if that's the DAPPS node here, use that callsign</div>`;
                if (!n.callsign.includes('-')) return '<div class="muted"><span class="pill warn">SSID?</span> no SSID means SSID 0; add the DAPPS node\'s SSID if it has one</div>';
                return '';
            };
            if (!ns.length) {
                body.innerHTML = '<tr><td colspan="7" class="empty" style="text-align:center;">No neighbours yet. Add one above.</td></tr>';
            } else {
                body.innerHTML = ns.map(n => `<tr>
                    <td><code>${escape(n.callsign)}</code>${ssidNote(n)}</td>
                    <td>${fmtPort(n.bearerPort)}</td>
                    <td>${n.udpEndpoint ? '<code>' + escape(n.udpEndpoint) + '</code>' : '<span class="muted">-</span>'}</td>
                    <td>${fmtCompression(n.compressionEnabled)}</td>
                    <td>${fmtHold(n.sessionTailSeconds)}</td>
                    <td>${n.connectScriptJson
                        ? (n.connectVia ? '<div>via <code>' + escape(n.connectVia) + '</code></div>' : '')
                          + '<pre class="connect-script" style="margin: 0; font-size: 0.8rem; white-space: pre;">' + escape(connectScriptLines(n.connectScriptJson)) + '</pre>'
                        : '<span class="muted">-</span>'}</td>
                    <td><div class="actions">
                        <button class="link-btn" onclick="dappsEditNeighbour('${escape(n.callsign)}')">edit</button>
                        <button class="link-btn" onclick="dappsProbeOne('${escape(n.callsign)}')">probe</button>
                        <button class="link-btn danger" onclick="dappsDeleteNeighbour('${escape(n.callsign)}')">remove</button>
                    </div></td>
                </tr>`).join('');
            }
        }

        if (tab === 'channels') {
            const body = document.getElementById('chan-body');
            const cs = t.discoveryChannels || [];
            window.__dappsChannels = cs;
            const fmtDur = (s) => s >= 3600 && s % 3600 === 0 ? `${s / 3600}h` : s >= 60 ? `${Math.round(s / 60)}m` : `${s}s`;
            // For AGW channels the channelKey is a 0-indexed port
            // number; resolve the human description so the row reads
            // "0 (VHF FM 1200 baud)" instead of just "0". UDP rows
            // (multicast addr) keep their key verbatim.
            const portMap = window.__dappsAgwPortMap || {};
            const fmtKey = (c) => {
                if (c.bearer === 'agw' && portMap[c.channelKey]) {
                    return `<code>${escape(c.channelKey)}</code> <span class="muted">(${escape(portMap[c.channelKey])})</span>`;
                }
                return `<code>${escape(c.channelKey)}</code>`;
            };
            if (!cs.length) {
                body.innerHTML = '<tr><td colspan="10" class="empty" style="text-align:center;">No discovery channels yet. Add one above.</td></tr>';
            } else {
                body.innerHTML = cs.map(c => `<tr>
                    <td>${escape(c.bearer)}</td>
                    <td>${fmtKey(c)}</td>
                    <td>${escape(linkClassLabel(c.linkClass))}</td>
                    <td class="numeric">${c.costHint}</td>
                    <td class="numeric">${fmtDur(c.beaconIntervalSeconds)}</td>
                    <td class="numeric">${fmtDur(c.advertisedTtlSeconds)}</td>
                    <td class="numeric">${c.airtimeBudgetSecondsPerHour > 0 ? c.airtimeBudgetSecondsPerHour + 's/h' : '<span class="muted">-</span>'}</td>
                    <td class="numeric">${c.solicitIntervalSeconds > 0 ? c.solicitIntervalSeconds + 's' : '<span class="muted">-</span>'}</td>
                    <td>${c.enabled ? '<span class="pill ok">yes</span>' : '<span class="pill warn">no</span>'}</td>
                    <td><div class="actions">
                        <button class="link-btn" onclick="dappsEditChannel(${c.id})">edit</button>
                        <button class="link-btn" onclick="dappsSetChannelEnabled(${c.id}, ${c.enabled ? 'false' : 'true'})">${c.enabled ? 'disable' : 'enable'}</button>
                        <button class="link-btn" onclick="dappsSolicitChannel(${c.id})" title="Send a one-shot 'who's there?'">solicit</button>
                        <button class="link-btn danger" onclick="dappsDeleteChannel(${c.id})">remove</button>
                    </div></td>
                </tr>`).join('');
            }
        }

        if (tab === 'peers') {
            const body = document.getElementById('peer-body');
            const ps = t.discoveredPeers || [];
            if (!ps.length) {
                body.innerHTML = '<tr><td colspan="6" class="empty" style="text-align:center;">No peers heard yet. Try a solicit on a channel.</td></tr>';
            } else {
                body.innerHTML = ps.map(p => `<tr>
                    <td><code>${escape(p.callsign)}</code></td>
                    <td>${escape(p.bearer)}</td>
                    <td><code>${escape(p.channelKey)}</code></td>
                    <td class="numeric">${p.hops}</td>
                    <td class="numeric">${p.costHint}</td>
                    <td>${fmtAgo(p.lastSeen)}</td>
                </tr>`).join('');
            }
        }

        if (tab === 'probes') {
            const body = document.getElementById('probe-body');
            const xs = t.probedNodes || [];
            if (!xs.length) {
                body.innerHTML = '<tr><td colspan="9" class="empty" style="text-align:center;">No probes recorded yet.</td></tr>';
            } else {
                body.innerHTML = xs.map(p => `<tr class="${p.consecutiveFailures >= 3 ? 'warn' : ''}">
                    <td><code>${escape(p.callsign)}</code></td>
                    <td>${escape(p.source || 'neighbour')}</td>
                    <td class="numeric">${p.lastBearerPort != null ? p.lastBearerPort : '<span class="muted">-</span>'}</td>
                    <td>${fmtAgo(p.lastProbedAt)}</td>
                    <td>${p.lastSuccessAt ? fmtAgo(p.lastSuccessAt) : '<span class="muted">never</span>'}</td>
                    <td class="numeric">${p.consecutiveFailures}</td>
                    <td><span class="muted">${escape(p.lastError || '-')}</span></td>
                    <td><label style="display:inline-flex; align-items:center; gap:0.3rem;"><input type="checkbox" ${p.optOut ? 'checked' : ''} onchange="dappsSetOptOut('${escape(p.callsign)}', this.checked)" /> opt-out</label></td>
                    <td><div class="actions">
                        <button class="link-btn" onclick="dappsProbeOne('${escape(p.callsign)}')">probe now</button>
                        <button class="link-btn danger" onclick="dappsForgetProbe('${escape(p.callsign)}')">forget</button>
                    </div></td>
                </tr>`).join('');
            }
        }

        if (tab === 'polls') {
            const body = document.getElementById('poll-body');
            const xs = t.polledNodes || [];
            if (!xs.length) {
                body.innerHTML = '<tr><td colspan="8" class="empty" style="text-align:center;">No polls recorded yet (enable scheduled poll in Settings, or use the button above).</td></tr>';
            } else {
                body.innerHTML = xs.map(p => `<tr class="${p.consecutiveFailures >= 3 ? 'warn' : ''}">
                    <td><code>${escape(p.callsign)}</code></td>
                    <td>${fmtAgo(p.lastPolledAt)}</td>
                    <td>${p.lastSuccessAt ? fmtAgo(p.lastSuccessAt) : '<span class="muted">never</span>'}</td>
                    <td class="numeric">${p.consecutiveFailures}</td>
                    <td class="numeric">${p.messagesDrained}</td>
                    <td><span class="muted">${escape(p.lastError || '-')}</span></td>
                    <td><label style="display:inline-flex; align-items:center; gap:0.3rem;"><input type="checkbox" ${p.optOut ? 'checked' : ''} onchange="dappsSetPollOptOut('${escape(p.callsign)}', this.checked)" /> opt-out</label></td>
                    <td><div class="actions">
                        <button class="link-btn" onclick="dappsPollOne('${escape(p.callsign)}')">poll now</button>
                        <button class="link-btn danger" onclick="dappsForgetPoll('${escape(p.callsign)}')">forget</button>
                    </div></td>
                </tr>`).join('');
            }
        }
    }

    if (window.__dappsSnap) apply(window.__dappsSnap);
    if (window.dappsOnSnap) window.dappsOnSnap(apply);
})();
</script>
